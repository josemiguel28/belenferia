---
// InfoSection.astro — ¿Qué necesito saber?
// Fondo cream, misma identidad visual que el resto del sitio
// Iconos SVG outline en lugar de emojis
---

<!-- SVG icons reutilizables -->
<svg style="display:none" aria-hidden="true">
  <defs>
    <symbol
      id="icon-pin"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M8 2A4 4 0 0 0 4 6c0 3 4 8 4 8s4-5 4-8a4 4 0 0 0-4-4Z"></path>
      <circle cx="8" cy="6" r="1.5"></circle>
    </symbol>
    <symbol
      id="icon-clock"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="8" cy="8" r="6"></circle>
      <path d="M8 5v3l2 1"></path>
    </symbol>
    <symbol
      id="icon-phone"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M3 3.5A1.5 1.5 0 0 1 4.5 2h.5a1 1 0 0 1 1 1v1.5a1 1 0 0 1-.5.866L5 6s.5 2 2 3.5 3.5 2 3.5 2l.634-.5A1 1 0 0 1 12 11h1.5a1 1 0 0 1 1 1v.5A1.5 1.5 0 0 1 13 14C7.5 14 2 8.5 2 3.5 2 2.672 2.672 2 3.5 2"
      ></path>
    </symbol>
    <symbol
      id="icon-map"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M2 4.5 6 3l4 2 4-1.5V12.5L14 14l-4-2-4 2-4-2V4.5Z"></path>
      <path d="M6 3v11M10 5v9"></path>
    </symbol>
  </defs>
</svg>

<section id="info" class="info-section" aria-label="Información práctica">
  <div class="container">
    <!-- Info blocks -->
    <div class="info-grid">
      <!-- Cómo llegar -->
      <div class="info-block">
        <div class="info-block-header">
          <svg class="info-block-icon" aria-hidden="true"
            ><use href="#icon-map"></use></svg
          >
          <h3 class="info-block-title">Cómo llegar</h3>
        </div>
        <p class="info-text">
          Belén está ubicado en el departamento de Lempira, Honduras. Acceso por
          carretera desde Gracias (aprox. 35 km).
        </p>
        <a
          href="https://maps.google.com?q=Belen+Lempira+Honduras"
          target="_blank"
          rel="noopener noreferrer"
          class="info-map-cta"
          aria-label="Ver Belén, Lempira en Google Maps (abre en nueva pestaña)"
        >
          Ver en Google Maps
          <svg
            class="info-ext-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 12 12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M2 6h8M7 3l3 3-3 3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Sección con fondo sutil ─────────────────────── */
  .info-section {
    background-color: var(--color-bg-subtle);
    border-top: 1px solid var(--color-border);
    padding-block: 3rem 3.5rem;
  }

  /* ─── Header ─────────────────────────────────────── */
  .info-header {
    margin-bottom: 2rem;
  }

  .info-eyebrow {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 0.5rem;
  }

  .info-title {
    font-family: var(--font-body);
    font-size: clamp(1.5rem, 6vw, 2.25rem);
    font-weight: 800;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  /* ─── Grid ───────────────────────────────────────── */
  .info-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ─── Block ──────────────────────────────────────── */
  .info-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-block-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .info-block-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--color-muted);
    opacity: 0.8;
  }

  .info-block-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }

  /* ─── Lista ──────────────────────────────────────── */
  .info-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .info-list-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.625rem 0;
  }

  .info-list-item + .info-list-item {
    border-top: 1px solid var(--color-border);
  }

  .info-list-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .info-list-detail {
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  /* Horarios: acento naranja */
  .info-list-time {
    font-weight: 600;
    color: var(--color-accent);
  }

  /* ─── Links ──────────────────────────────────────── */
  .info-link {
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid var(--color-border);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .info-link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .info-text {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* CTA maps */
  .info-map-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    min-height: 44px;
    padding: 0.375rem 0;
    transition: color 0.15s ease;
  }

  .info-map-cta:hover {
    color: var(--color-accent);
  }

  .info-ext-icon {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    color: var(--color-accent);
  }
</style>
