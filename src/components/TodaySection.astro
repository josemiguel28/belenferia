---
// TodaySection.astro — Sección temporal principal de la Feria
// Maneja automáticamente los 3 estados: BEFORE, DURING y AFTER según la hora oficial de Honduras.
import type { FeriaDay } from "../data/feria";
import type { FairState } from "../utils/fairState";

interface Props {
  fairState: FairState;
  days?: FeriaDay[];
}

const { fairState, days } = Astro.props;

// Durante la feria: día actual y conteo de actividades
const todayDay = fairState.currentDay ?? (days ? days[fairState.currentDayIndex] : undefined);
const activityCount = todayDay?.activities.length ?? 0;
const activityCountText = `${activityCount} ${activityCount === 1 ? "actividad" : "actividades"}`;
const fullDateTitle = fairState.dateFormatted; // "Martes 6 de octubre"

// Días restantes antes de la feria
const daysUntil = fairState.daysUntil ?? 1;
const daysUntilText = daysUntil === 1 ? "Falta 1 día" : `Faltan ${daysUntil} días`;
---

<section id="hoy" class="today-section" aria-label={fairState.status === "DURING" ? "¿Qué hay hoy?" : "Estado de la feria"}>
  <div class="container">

    {/* ══════════════════════════════════════════════════════════════
        ESTADO: DURING (Durante la Feria)
        ══════════════════════════════════════════════════════════════ */}
    {fairState.status === "DURING" && todayDay && (
      <>
        <!-- Encabezado de Hoy -->
        <header class="today-header">
          <p class="today-eyebrow">¿QUÉ HAY HOY?</p>
          <h2 class="today-title">{fullDateTitle}</h2>
          <p class="today-count">{activityCountText}</p>
        </header>

        <!-- Lista interactiva de Actividades de Hoy -->
        <div class="today-list" role="list" aria-label={`Actividades del ${fullDateTitle}`}>
          {todayDay.activities.map((act) => (
            <div role="listitem">
              <button
                type="button"
                class="today-act-card"
                data-open-activity
                data-title={act.title}
                data-time={act.time}
                data-date={fullDateTitle}
                data-category={act.category}
                data-description={act.description ?? ""}
                data-maps-url={act.mapsUrl ?? ""}
                aria-label={`Ver detalles de ${act.title}, a las ${act.time}`}
              >
                <!-- Columna de Hora -->
                <div class="act-time-col">
                  <span class="act-time">{act.time}</span>
                </div>

                <!-- Información principal -->
                <div class="act-body">
                  <h3 class="act-title">{act.title}</h3>
                </div>

                <!-- Chevron interactivo -->
                <div class="act-arrow-col" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    class="chevron-icon"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </div>
              </button>
            </div>
          ))}
        </div>

        <!-- Acceso al Programa Completo -->
        <div class="today-cta-wrap">
          <button
            type="button"
            class="btn-full-schedule"
            data-open-schedule
            aria-label="Ver el programa completo con todos los días de la feria"
          >
            <span>Ver programa completo</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
              class="cta-arrow"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        </div>
      </>
    )}

    {/* ══════════════════════════════════════════════════════════════
        ESTADO: BEFORE (Antes de la Feria)
        ══════════════════════════════════════════════════════════════ */}
    {fairState.status === "BEFORE" && (
      <div class="state-card state-card--before">
        <header class="state-header">
          <p class="today-eyebrow">LA FERIA COMIENZA PRONTO</p>
          <h2 class="today-title">La feria comienza pronto</h2>
          <div class="state-badge-row">
            <span class="state-date-tag">5 de octubre de 2026</span>
            <span class="state-countdown-badge">{daysUntilText}</span>
          </div>
          <p class="state-desc">
            Conoce el programa de actividades de la Feria Patronal de Belén.
          </p>
        </header>

        <div class="today-cta-wrap today-cta-wrap--center">
          <button
            type="button"
            class="btn-full-schedule"
            data-open-schedule
            aria-label="Ver el programa completo con todos los días de la feria"
          >
            <span>Ver programa completo</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
              class="cta-arrow"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        </div>
      </div>
    )}

    {/* ══════════════════════════════════════════════════════════════
        ESTADO: AFTER (Feria Finalizada)
        ══════════════════════════════════════════════════════════════ */}
    {fairState.status === "AFTER" && (
      <div class="state-card state-card--after">
        <header class="state-header">
          <p class="today-eyebrow">FERIA FINALIZADA</p>
          <h2 class="today-title">La feria ha terminado</h2>
          <p class="state-date-tag">5–11 de octubre de 2026</p>
          <p class="state-desc">
            Gracias por celebrar con nosotros. Puedes consultar el programa de lo que se vivió en la feria o explorar los recuerdos del pueblo.
          </p>
        </header>

        <div class="state-buttons-grid">
          <button
            type="button"
            class="btn-full-schedule"
            data-open-schedule
            aria-label="Ver el programa completo de la feria"
          >
            <span>Ver programa completo</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
              class="cta-arrow"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z"
                clip-rule="evenodd"
              />
            </svg>
          </button>

          <a
            href="#asi-se-vive"
            class="btn-full-schedule btn-full-schedule--secondary"
            aria-label="Ver fotos y recuerdos de Así se vive Belén"
          >
            <span>Así se vive Belén</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
              class="cta-arrow"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
        </div>
      </div>
    )}

  </div>
</section>

<style>
  /* ─── Sección ────────────────────────────────────── */
  .today-section {
    background-color: var(--color-bg);
    padding-block: 2.5rem 2.5rem;
  }

  /* ─── Encabezado ─────────────────────────────────── */
  .today-header {
    margin-bottom: 1.5rem;
  }

  .today-eyebrow {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.35rem;
  }

  .today-title {
    font-family: var(--font-body);
    font-size: clamp(1.75rem, 6.5vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin: 0 0 0.35rem;
  }

  .today-count {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    margin: 0;
  }

  /* ─── Lista de Actividades ───────────────────────── */
  .today-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: #FFFFFF;
  }

  .today-list > div + div {
    border-top: 1px solid var(--color-border);
  }

  /* ─── Fila / Tarjeta Interactiva ─────────────────── */
  .today-act-card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    padding: 1rem 1.125rem;
    min-height: 64px;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    text-decoration: none;
    font-family: inherit;
    transition: background-color 0.15s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .today-act-card:hover {
    background-color: #F8F9FA;
  }

  .today-act-card:active {
    background-color: #F1F3F5;
  }

  .today-act-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  /* ─── Columna de Hora ────────────────────────────── */
  .act-time-col {
    flex-shrink: 0;
    width: 4.5rem;
    text-align: left;
  }

  .act-time {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    color: var(--color-accent);
    line-height: 1.2;
    display: inline-block;
  }

  /* ─── Cuerpo de la Actividad ─────────────────────── */
  .act-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .act-title {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-ink);
    margin: 0;
    word-break: break-word;
  }

  /* ─── Chevron ────────────────────────────────────── */
  .act-arrow-col {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #9CA3AF;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .chevron-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .today-act-card:hover .act-arrow-col {
    transform: translateX(2px);
    color: var(--color-accent);
  }

  /* ─── Estructura de Tarjetas para BEFORE y AFTER ──── */
  .state-card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem 1.5rem;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .state-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .state-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.25rem;
  }

  .state-date-tag {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
  }

  .state-countdown-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background-color: rgba(240, 90, 22, 0.12);
    color: var(--color-accent);
    padding: 0.25rem 0.625rem;
    border-radius: 4px;
  }

  .state-desc {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0.25rem 0 0;
  }

  .state-buttons-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .state-buttons-grid {
      flex-direction: row;
      gap: 1rem;
    }
  }

  /* ─── CTA "Ver programa completo →" ──────────────── */
  .today-cta-wrap {
    margin-top: 1.25rem;
  }

  .today-cta-wrap--center {
    margin-top: 0;
  }

  .btn-full-schedule {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 50px;
    padding: 0.875rem 1.25rem;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease, transform 0.12s ease;
    letter-spacing: -0.01em;
  }

  .btn-full-schedule:hover {
    border-color: #D1D5DB;
    background-color: #F9FAFB;
    color: var(--color-accent);
  }

  .btn-full-schedule:active {
    transform: scale(0.985);
  }

  .btn-full-schedule--secondary {
    background-color: #F9FAFB;
  }

  .btn-full-schedule--secondary:hover {
    background-color: #F3F4F6;
  }

  .cta-arrow {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .btn-full-schedule:hover .cta-arrow {
    transform: translateX(3px);
  }

  /* ─── Tablet & Desktop Responsive Scaling ──────────── */
  @media (min-width: 640px) {
    .btn-full-schedule {
      width: auto;
      min-width: 240px;
    }
  }

  @media (min-width: 768px) {
    .today-section {
      padding-block: 4rem 3.5rem;
    }

    .today-section .container {
      max-width: 780px;
    }

    .today-header {
      margin-bottom: 2rem;
    }

    .today-title {
      font-size: 2.25rem;
    }

    .today-list {
      gap: 0.625rem;
    }

    .today-act-card {
      padding: 1.125rem 1.25rem;
      border-radius: 10px;
    }

    .act-time-col {
      width: 5.75rem;
    }

    .act-time {
      font-size: 0.875rem;
    }

    .act-title {
      font-size: 1.0625rem;
    }

    .state-card {
      padding: 3rem 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .today-section {
      padding-block: 5rem 4.5rem;
    }

    .today-section .container {
      max-width: 820px;
    }

    .today-header {
      margin-bottom: 2.25rem;
    }

    .today-title {
      font-size: 2.5rem;
    }

    .today-act-card {
      padding: 1.25rem 1.5rem;
      border-radius: 12px;
    }

    .act-time-col {
      width: 6.25rem;
    }

    .act-time {
      font-size: 0.9375rem;
    }

    .act-title {
      font-size: 1.125rem;
    }

    .today-cta-wrap {
      margin-top: 1.75rem;
    }

    .btn-full-schedule {
      padding: 1rem 2rem;
      font-size: 1rem;
      min-width: 260px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .today-act-card,
    .btn-full-schedule,
    .act-arrow-col,
    .cta-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
