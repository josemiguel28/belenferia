---
// TodaySection.astro — ¿Qué hay hoy?
// Muestra las actividades del día actual con tarjetas interactivas y acceso directo al programa completo.
import type { FeriaDay } from "../data/feria";

interface Props {
  todayDay?: FeriaDay;
  days?: FeriaDay[];
  initialDayIndex?: number;
  totalDays?: number;
}

const { todayDay: propTodayDay, days, initialDayIndex = 0 } = Astro.props;

// Determinar el día de hoy
const todayDay = propTodayDay ?? (days ? days[initialDayIndex] : undefined);

if (!todayDay) {
  throw new Error("TodaySection requires a valid todayDay or days array.");
}

// Formatear la fecha en español: "Martes 6 de octubre"
const d = new Date(todayDay.date + "T12:00:00");
const weekdayLong = d.toLocaleDateString("es-HN", { weekday: "long" });
const weekdayCap = weekdayLong.charAt(0).toUpperCase() + weekdayLong.slice(1);
const dayNumber = d.getDate();
const monthName = d.toLocaleDateString("es-HN", { month: "long" });
const fullDateTitle = `${weekdayCap} ${dayNumber} de ${monthName}`;
const activityCountText = `${todayDay.activities.length} ${todayDay.activities.length === 1 ? "actividad" : "actividades"}`;
---

<section id="hoy" class="today-section" aria-label="¿Qué hay hoy?">
  <div class="container">

    <!-- ── Encabezado ─────────────────────────────── -->
    <header class="today-header">
      <p class="today-eyebrow">¿QUÉ HAY HOY?</p>
      <h2 class="today-title">{fullDateTitle}</h2>
      <p class="today-count">{activityCountText}</p>
    </header>

    <!-- ── Lista de Actividades de Hoy ───────────── -->
    <div class="today-list" role="list" aria-label={`Actividades del ${fullDateTitle}`}>
      {todayDay.activities.map((act) => (
        <div role="listitem">
          <button
            type="button"
            class="today-act-card"
            data-open-activity
            data-title={act.title}
            data-time={act.time}
            data-date={fullDateTitle}
            data-location={act.location}
            data-category={act.category}
            data-description={act.description ?? ""}
            data-maps-url={act.mapsUrl ?? ""}
            aria-label={`Ver detalles de ${act.title}, a las ${act.time} en ${act.location}`}
          >
            <!-- Columna de Hora -->
            <div class="act-time-col">
              <span class="act-time">{act.time}</span>
            </div>

            <!-- Información principal -->
            <div class="act-body">
              <h3 class="act-title">{act.title}</h3>
              <p class="act-location">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="loc-pin-icon"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="m9.69 18.933.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 0 0 .281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 1 0 3 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 0 0 2.273 1.765 11.842 11.842 0 0 0 .976.541l.062.029.018-.008.006-.003ZM10 11.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span>{act.location}</span>
              </p>
            </div>

            <!-- Chevron interactivo -->
            <div class="act-arrow-col" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 16 16"
                fill="currentColor"
                class="chevron-icon"
              >
                <path
                  fill-rule="evenodd"
                  d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z"
                  clip-rule="evenodd"
                />
              </svg>
            </div>
          </button>
        </div>
      ))}
    </div>

    <!-- ── Acceso al Programa Completo ───────────── -->
    <div class="today-cta-wrap">
      <button
        type="button"
        class="btn-full-schedule"
        data-open-schedule
        aria-label="Ver el programa completo con todos los días de la feria"
      >
        <span>Ver programa completo</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 16 16"
          fill="currentColor"
          class="cta-arrow"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z"
            clip-rule="evenodd"
          />
        </svg>
      </button>
    </div>

  </div>
</section>

<style>
  /* ─── Sección ────────────────────────────────────── */
  .today-section {
    background-color: var(--color-bg);
    padding-block: 2.5rem 2.5rem;
  }

  /* ─── Encabezado ─────────────────────────────────── */
  .today-header {
    margin-bottom: 1.5rem;
  }

  .today-eyebrow {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.35rem;
  }

  .today-title {
    font-family: var(--font-body);
    font-size: clamp(1.75rem, 6.5vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin: 0 0 0.35rem;
  }

  .today-count {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    margin: 0;
  }

  /* ─── Lista de Actividades ───────────────────────── */
  .today-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: #FFFFFF;
  }

  .today-list > div + div {
    border-top: 1px solid var(--color-border);
  }

  /* ─── Fila / Tarjeta Interactiva ─────────────────── */
  .today-act-card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    padding: 1rem 1.125rem;
    min-height: 64px;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    text-decoration: none;
    font-family: inherit;
    transition: background-color 0.15s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .today-act-card:hover {
    background-color: #F8F9FA;
  }

  .today-act-card:active {
    background-color: #F1F3F5;
  }

  .today-act-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  /* ─── Columna de Hora ────────────────────────────── */
  .act-time-col {
    flex-shrink: 0;
    width: 4.5rem;
    text-align: left;
  }

  .act-time {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    color: var(--color-accent);
    line-height: 1.2;
    display: inline-block;
  }

  /* ─── Cuerpo de la Actividad ─────────────────────── */
  .act-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .act-title {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-ink);
    margin: 0;
    word-break: break-word;
  }

  .act-location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-muted);
    line-height: 1.3;
    margin: 0;
  }

  .loc-pin-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    color: var(--color-muted);
    opacity: 0.75;
  }

  /* ─── Chevron ────────────────────────────────────── */
  .act-arrow-col {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #9CA3AF;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .chevron-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .today-act-card:hover .act-arrow-col {
    transform: translateX(2px);
    color: var(--color-accent);
  }

  /* ─── CTA "Ver programa completo →" ──────────────── */
  .today-cta-wrap {
    margin-top: 1.25rem;
  }

  .btn-full-schedule {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 50px;
    padding: 0.875rem 1.25rem;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease, transform 0.12s ease;
    letter-spacing: -0.01em;
  }

  .btn-full-schedule:hover {
    border-color: #D1D5DB;
    background-color: #F9FAFB;
    color: var(--color-accent);
  }

  .btn-full-schedule:active {
    transform: scale(0.985);
  }

  .cta-arrow {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .btn-full-schedule:hover .cta-arrow {
    transform: translateX(3px);
  }

  /* ─── Desktop (>= 640px) ─────────────────────────── */
  @media (min-width: 640px) {
    .today-section {
      padding-block: 3.5rem 3rem;
    }

    .act-time-col {
      width: 5.5rem;
    }

    .act-title {
      font-size: 1rem;
    }

    .btn-full-schedule {
      width: auto;
      min-width: 260px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .today-act-card,
    .btn-full-schedule,
    .act-arrow-col,
    .cta-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
