---
// SiteFooter.astro — Footer claro, minimalista y moderno
interface Props {
  feriaName?: string;
  town?: string;
  department?: string;
  year?: number;
  patronSaint?: string;
  dates?: string;
}

const {
  feriaName = "Feria Patronal de Belén",
  town = "Belén",
  department = "Lempira, Honduras",
  year = 2026,
  dates = "5 al 11 de octubre de 2026",
} = Astro.props;
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <!-- Fila superior: Información principal y navegación -->
    <div class="footer-top">
      <!-- Identidad y contexto de la feria -->
      <div class="footer-info">
        <h2 class="footer-title">{feriaName.toUpperCase()}</h2>
        <div class="footer-meta">
          <p class="footer-meta-item">{town} · {department}</p>
          <p class="footer-meta-item">{dates}</p>
        </div>
      </div>

      <!-- Enlaces de navegación rápida -->
      <nav class="footer-nav" aria-label="Navegación del footer">
        <a href="#hoy" class="footer-nav-link">Hoy</a>
        <button
          type="button"
          class="footer-nav-link footer-nav-btn"
          data-open-schedule>Programa completo</button
        >
        <a href="#pueblo" class="footer-nav-link">El pueblo</a>
        <a href="#info" class="footer-nav-link">Información</a>
      </nav>
    </div>

    <hr class="footer-divider" />

    <!-- Fila inferior: Firma del desarrollador y Copyright -->
    <div class="footer-bottom">
      <!-- Referencia discreta al desarrollador -->
      <div class="footer-credit">
        <span class="footer-credit-text"
          >Diseñado y desarrollado por Miguel Portillo</span
        >
        <a
          href="https://josemiguel28-github-io.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-portfolio-link"
          aria-label="Ver portafolio de Miguel Portillo (abre en nueva pestaña)"
        >
          Ver portafolio
          <svg
            class="footer-link-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M2.5 7h9M7.5 3l4 4-4 4"></path>
          </svg>
        </a>
      </div>

      <!-- Copyright -->
      <p class="footer-copy">© {year} {feriaName}</p>
    </div>
  </div>
</footer>

<style>
  /* ─── Footer Base ───────────────────────────────────── */
  .site-footer {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding-block: 3rem 2.5rem;
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .site-footer {
      padding-block: 3.5rem 3rem;
    }
  }

  @media (min-width: 1024px) {
    .site-footer {
      padding-block: 4.5rem 3.5rem;
    }
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .footer-inner {
      gap: 2.5rem;
    }
  }

  /* ─── Fila Superior ─────────────────────────────────── */
  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .footer-top {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .footer-top {
      gap: 3rem;
    }
  }

  /* ─── Identidad de la Feria ─────────────────────────── */
  .footer-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-title {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.3;
  }

  @media (min-width: 1024px) {
    .footer-title {
      font-size: 0.9375rem;
    }
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .footer-meta-item {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.45;
  }

  /* ─── Navegación ────────────────────────────────────── */
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  @media (min-width: 640px) {
    .footer-nav {
      justify-content: flex-end;
      gap: 0.75rem 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .footer-nav {
      gap: 1rem 2.25rem;
    }
  }

  .footer-nav-link {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0.375rem 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  @media (min-width: 1024px) {
    .footer-nav-link {
      font-size: 0.9375rem;
    }
  }

  .footer-nav-link:hover {
    color: var(--color-accent);
  }

  /* ─── Divisor ───────────────────────────────────────── */
  .footer-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }

  /* ─── Fila Inferior ─────────────────────────────────── */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
    }
  }

  /* ─── Créditos del Desarrollador ────────────────────── */
  .footer-credit {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  @media (min-width: 480px) {
    .footer-credit {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
    }
  }

  .footer-credit-text {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin: 0;
  }

  .footer-portfolio-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.15s ease;
    min-height: 36px;
  }

  .footer-portfolio-link:hover {
    opacity: 0.8;
  }

  .footer-link-icon {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .footer-portfolio-link:hover .footer-link-icon {
    transform: translateX(2px);
  }

  /* ─── Copyright ─────────────────────────────────────── */
  .footer-copy {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin: 0;
  }
</style>
