---
// ActivityDetailModal.astro — Bottom Sheet / Modal de Detalle de Actividad
// Se abre al tocar cualquier actividad (desde "¿Qué hay hoy?", Programa Completo o Próximas actividades).
// Incluye botón de acción para avanzar a la "Siguiente actividad" (se oculta al llegar a la última).
---

<div id="activity-detail-backdrop" class="activity-backdrop" aria-hidden="true">
  <div
    id="activity-detail-sheet"
    class="activity-sheet"
    role="dialog"
    aria-modal="true"
    aria-labelledby="activity-detail-title"
    tabindex="-1"
  >
    <!-- Drag handle para mobile -->
    <div class="sheet-handle-bar" aria-hidden="true">
      <div class="sheet-drag-pill"></div>
    </div>

    <!-- Header del detalle -->
    <header class="sheet-header">
      <div class="header-top-row">
        <span id="activity-detail-cat" class="detail-cat-badge">CATEGORÍA</span>
        <button
          type="button"
          id="activity-detail-close"
          class="sheet-close-btn"
          aria-label="Cerrar detalle de actividad"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="close-icon"
            aria-hidden="true"
          >
            <path
              d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 0 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 0 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"
            ></path>
          </svg>
        </button>
      </div>

      <h2 id="activity-detail-title" class="detail-title">
        Nombre de la Actividad
      </h2>
    </header>

    <!-- Contenido del detalle -->
    <div class="sheet-body" id="activity-detail-body">
      <!-- Fichas de información clave -->
      <div class="detail-meta-list">
        <!-- Hora -->
        <div class="meta-item">
          <div class="meta-icon-wrap" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="meta-icon"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <div class="meta-content">
            <span class="meta-label">Hora</span>
            <span id="activity-detail-time" class="meta-value">--:--</span>
          </div>
        </div>

        <!-- Fecha -->
        <div class="meta-item">
          <div class="meta-icon-wrap" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="meta-icon"
            >
              <path
                fill-rule="evenodd"
                d="M5.75 2a.75.75 0 0 1 .75.75V4h7V2.75a.75.75 0 0 1 1.5 0V4h.25A2.75 2.75 0 0 1 18 6.75v8.5A2.75 2.75 0 0 1 15.25 18H4.75A2.75 2.75 0 0 1 2 15.25v-8.5A2.75 2.75 0 0 1 4.75 4H5V2.75A.75.75 0 0 1 5.75 2Zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75Z"
                clip-rule="evenodd"
              />
            </svg>
          </div>
          <div class="meta-content">
            <span class="meta-label">Fecha</span>
            <span id="activity-detail-date" class="meta-value">--</span>
          </div>
        </div>
      </div>

      <!-- Descripción opcional (solo se muestra si existe en los datos reales) -->
      <div
        id="activity-detail-desc-wrap"
        class="detail-desc-wrap"
        style="display: none;"
      >
        <p class="desc-heading">Detalles</p>
        <p id="activity-detail-desc" class="detail-desc"></p>
      </div>

      <!-- CTA: Ver Siguiente Actividad (se oculta automáticamente en la última actividad) -->
      <div id="activity-detail-cta-wrap" class="detail-cta-wrap">
        <button
          type="button"
          id="activity-detail-next-btn"
          class="detail-next-btn"
          aria-label="Ver siguiente actividad"
        >
          <span>Ver siguiente actividad</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            fill="currentColor"
            class="next-btn-arrow"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const CAT_MAP: Record<string, string> = {
    cultural: "CULTURAL",
    religioso: "RELIGIOSO",
    musical: "MUSICAL",
    deportivo: "DEPORTIVO",
    tradicional: "TRADICIONAL",
    desfile: "DESFILE",
    gastronomico: "GASTRONÓMICO",
  };

  function setupActivityDetail() {
    const backdrop = document.getElementById("activity-detail-backdrop");
    const sheet = document.getElementById("activity-detail-sheet");
    const sheetBody = document.getElementById("activity-detail-body");
    const closeBtn = document.getElementById("activity-detail-close");
    const nextBtn = document.getElementById("activity-detail-next-btn");
    const ctaWrap = document.getElementById("activity-detail-cta-wrap");

    const catEl = document.getElementById("activity-detail-cat");
    const titleEl = document.getElementById("activity-detail-title");
    const timeEl = document.getElementById("activity-detail-time");
    const dateEl = document.getElementById("activity-detail-date");
    const descWrapEl = document.getElementById("activity-detail-desc-wrap");
    const descEl = document.getElementById("activity-detail-desc");

    if (!backdrop || !sheet) return;

    let currentTriggerElement: HTMLElement | null = null;
    let previousActiveElement: HTMLElement | null = null;

    const updateNextButtonState = (el: HTMLElement) => {
      if (!ctaWrap) return;

      const container =
        el.closest('[role="list"]') ||
        el.closest(".schedule-day-content") ||
        document;

      const items = Array.from(
        container.querySelectorAll<HTMLElement>("[data-open-activity]"),
      );

      const currentIndex = items.indexOf(el);
      // Hay siguiente si el elemento está en la lista y no es el último índice
      const hasNext = currentIndex !== -1 && currentIndex < items.length - 1;

      ctaWrap.style.display = hasNext ? "block" : "none";
    };

    const renderActivityData = (el: HTMLElement) => {
      const data = {
        title: el.dataset.title || "",
        time: el.dataset.time || "",
        date: el.dataset.date || "",
        category: el.dataset.category || "",
        description: el.dataset.description || "",
      };

      if (titleEl) titleEl.textContent = data.title;
      if (timeEl) timeEl.textContent = data.time;
      if (dateEl) dateEl.textContent = data.date;

      const catKey = (data.category || "").toLowerCase();
      if (catEl)
        catEl.textContent =
          CAT_MAP[catKey] || data.category?.toUpperCase() || "ACTIVIDAD";

      if (descWrapEl && descEl) {
        if (data.description && data.description.trim() !== "") {
          descEl.textContent = data.description.trim();
          descWrapEl.style.display = "block";
        } else {
          descEl.textContent = "";
          descWrapEl.style.display = "none";
        }
      }

      updateNextButtonState(el);
    };

    const openWithElement = (el: HTMLElement) => {
      currentTriggerElement = el;
      renderActivityData(el);

      backdrop.classList.add("is-open");
      sheet.classList.add("is-visible");
      backdrop.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      sheet.focus();
    };

    const goToNextActivity = () => {
      if (!currentTriggerElement) return;

      const container =
        currentTriggerElement.closest('[role="list"]') ||
        currentTriggerElement.closest(".schedule-day-content") ||
        document;

      const items = Array.from(
        container.querySelectorAll<HTMLElement>("[data-open-activity]"),
      );

      if (items.length === 0) return;

      const currentIndex = items.indexOf(currentTriggerElement);
      if (currentIndex === -1 || currentIndex >= items.length - 1) {
        // Ya estamos en el último, no hay siguiente
        if (ctaWrap) ctaWrap.style.display = "none";
        return;
      }

      const nextElement = items[currentIndex + 1];

      if (nextElement) {
        // Transición suave al pasar al siguiente
        sheet.classList.add("is-switching");
        setTimeout(() => {
          currentTriggerElement = nextElement;
          renderActivityData(nextElement);
          sheet.classList.remove("is-switching");
        }, 120);
      }
    };

    const close = () => {
      sheet.classList.remove("is-visible");
      backdrop.classList.remove("is-open");
      backdrop.setAttribute("aria-hidden", "true");

      // Si el modal de programa completo sigue abierto, no restauramos el scroll del body
      const scheduleModal = document.getElementById("schedule-modal-backdrop");
      if (!scheduleModal || !scheduleModal.classList.contains("is-open")) {
        document.body.style.overflow = "";
      }

      if (previousActiveElement) {
        previousActiveElement.focus();
      }
    };

    // Botón siguiente actividad
    nextBtn?.addEventListener("click", goToNextActivity);

    // Cerrar al pulsar el botón de cerrar
    closeBtn?.addEventListener("click", close);

    // Cerrar al pulsar el fondo oscuro
    backdrop.addEventListener("click", (e) => {
      if (e.target === backdrop) close();
    });

    // Cerrar con Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && backdrop.classList.contains("is-open")) {
        close();
      }
    });

    // Delegación global de clics en cualquier elemento con data-open-activity
    document.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest("[data-open-activity]");
      if (!target) return;

      e.preventDefault();
      previousActiveElement = document.activeElement as HTMLElement | null;
      openWithElement(target as HTMLElement);
    });

    // Exponer función global para abrir programáticamente si fuese necesario
    (window as any).openActivityDetail = (data: any) => {
      if (titleEl) titleEl.textContent = data.title;
      if (timeEl) timeEl.textContent = data.time;
      if (dateEl) dateEl.textContent = data.date;
      if (catEl)
        catEl.textContent =
          CAT_MAP[data.category?.toLowerCase()] ||
          data.category?.toUpperCase() ||
          "ACTIVIDAD";
      if (ctaWrap) ctaWrap.style.display = "none";
      backdrop.classList.add("is-open");
      sheet.classList.add("is-visible");
      backdrop.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };
    (window as any).closeActivityDetail = close;
  }

  setupActivityDetail();
  document.addEventListener("astro:page-load", setupActivityDetail);
</script>

<style>
  /* ─── Backdrop ─────────────────────────────────────── */
  .activity-backdrop {
    position: fixed;
    inset: 0;
    z-index: 300; /* Por encima del modal de programa completo */
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .activity-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* ─── Bottom Sheet (Mobile First) ─────────────────── */
  .activity-sheet {
    background-color: var(--color-bg);
    width: 100%;
    max-height: 85vh;
    border-radius: 16px 16px 0 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.16);
    transform: translateY(100%);
    transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }

  .activity-sheet.is-visible {
    transform: translateY(0);
  }

  .activity-sheet.is-switching .sheet-body,
  .activity-sheet.is-switching .detail-title {
    opacity: 0.3;
    transform: translateY(3px);
    transition:
      opacity 0.1s ease,
      transform 0.1s ease;
  }

  /* ─── Drag Handle (Mobile) ────────────────────────── */
  .sheet-handle-bar {
    display: flex;
    justify-content: center;
    padding: 0.625rem 0 0.25rem;
    flex-shrink: 0;
  }

  .sheet-drag-pill {
    width: 36px;
    height: 4px;
    border-radius: 999px;
    background-color: #d1d5db;
  }

  /* ─── Header ──────────────────────────────────────── */
  .sheet-header {
    padding: 0.5rem 1.25rem 1rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .header-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.625rem;
  }

  .detail-cat-badge {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(240, 90, 22, 0.1);
    border: 1px solid rgba(240, 90, 22, 0.2);
    padding: 0.25em 0.6em;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
  }

  .sheet-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f3f4f6;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
    flex-shrink: 0;
  }

  .sheet-close-btn:hover {
    background: #e5e7eb;
    color: var(--color-accent);
  }

  .close-icon {
    width: 18px;
    height: 18px;
  }

  .detail-title {
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 5vw, 1.5rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0;
    word-wrap: break-word;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  /* ─── Body ────────────────────────────────────────── */
  .sheet-body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 1.25rem 1.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  /* ─── Metadata List ───────────────────────────────── */
  .detail-meta-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: #f8f9fa;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 0.875rem 1rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .meta-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .meta-icon {
    width: 16px;
    height: 16px;
  }

  .meta-content {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    min-width: 0;
    flex: 1;
  }

  .meta-label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .meta-value {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.3;
    word-break: break-word;
  }

  /* ─── Descripción ─────────────────────────────────── */
  .detail-desc-wrap {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .desc-heading {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 0.35rem;
  }

  .detail-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-ink);
    margin: 0;
  }

  /* ─── CTA: Ver Siguiente Actividad ───────────────── */
  .detail-cta-wrap {
    padding-top: 0.25rem;
  }

  .detail-next-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 50px;
    padding: 0.875rem 1.25rem;
    background-color: var(--color-ink);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: -0.01em;
    transition:
      background-color 0.15s ease,
      transform 0.12s ease;
  }

  .detail-next-btn:hover {
    background-color: var(--color-accent);
  }

  .detail-next-btn:active {
    transform: scale(0.985);
  }

  .next-btn-arrow {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .detail-next-btn:hover .next-btn-arrow {
    transform: translateX(3px);
  }

  /* ─── Desktop (>= 640px) ──────────────────────────── */
  @media (min-width: 640px) {
    .activity-backdrop {
      align-items: center;
      padding: 1.5rem;
    }

    .sheet-handle-bar {
      display: none;
    }

    .activity-sheet {
      max-width: 480px;
      height: auto;
      max-height: 85vh;
      border-radius: 16px;
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.2);
      transform: scale(0.95);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .activity-sheet.is-visible {
      transform: scale(1);
    }

    .sheet-header {
      padding: 1.25rem 1.5rem 1rem;
    }

    .sheet-body {
      padding: 1.25rem 1.5rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .activity-backdrop,
    .activity-sheet,
    .detail-next-btn,
    .next-btn-arrow {
      transition: none !important;
      transform: none !important;
    }
    .activity-sheet.is-visible {
      transform: none !important;
    }
  }
</style>
