---
// UpcomingSection.astro — Previsualización de lo que viene inmediatamente después
// Muestra únicamente el día siguiente (Mañana) + botón "Ver programa completo →"
import type { FeriaDay } from "../data/feria";
import ActivityRow from "./ActivityRow.astro";

interface Props {
  days: FeriaDay[];   // días DESPUÉS de hoy, en orden
}

const { days } = Astro.props;

const tomorrow = days[0];

// Full day name for tomorrow
const tomorrowFull = (day: FeriaDay) => {
  const d = new Date(day.date + "T12:00:00");
  const wd = d.toLocaleDateString("es-HN", { weekday: "long" });
  const wdCap = wd.charAt(0).toUpperCase() + wd.slice(1);
  const month = d.toLocaleDateString("es-HN", { month: "long" });
  return `${wdCap} ${day.dayNumber} de ${month}`;
};
---

<section id="proximo" class="upcoming-section" aria-label="Próximas actividades" style="scroll-margin-top: 56px;">
  <div class="container">

    <!-- Header -->
    <div class="upcoming-header">
      <p class="section-eyebrow upcoming-eyebrow">¿Qué viene después?</p>
    </div>

    <!-- ── Mañana (Previsualización única) ─────────── -->
    {tomorrow ? (
      <div class="tomorrow-block">
        <h2 class="tomorrow-title">
          <span class="tomorrow-label">Mañana</span>
          <span class="tomorrow-day">— {tomorrowFull(tomorrow)}</span>
        </h2>
        <div class="tomorrow-list" role="list" aria-label={`Actividades de mañana`}>
          {tomorrow.activities.map((act) => (
            <div role="listitem">
              <ActivityRow activity={act} compact={true} dateLabel={tomorrowFull(tomorrow)} />
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="tomorrow-block">
        <h2 class="tomorrow-title">
          <span class="tomorrow-label">Último día de feria</span>
        </h2>
        <p class="tomorrow-empty-msg">Hoy concluyen las festividades de la feria patronal.</p>
      </div>
    )}

    <!-- ── Botón: Ver programa completo → ── -->
    <div class="upcoming-cta-wrap">
      <button
        type="button"
        class="btn-see-all-schedule"
        data-open-schedule
        aria-label="Ver el programa completo con todos los días de la feria"
      >
        <span>Ver programa completo</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="cta-arrow" aria-hidden="true">
          <path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>

  </div>
</section>

<style>
  .upcoming-section {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding-block: 2.75rem 3.25rem;
  }

  /* ─── Header ──────────────────────────────────────── */
  .upcoming-header {
    margin-bottom: 1.25rem;
  }

  .upcoming-eyebrow {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }

  /* ─── Mañana ──────────────────────────────────────── */
  .tomorrow-block {
    margin-bottom: 1.5rem;
  }

  .tomorrow-title {
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 5vw, 1.625rem);
    font-weight: 800;
    color: var(--color-ink);
    margin: 0 0 1rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
  }

  .tomorrow-label {
    color: var(--color-ink);
    font-weight: 800;
  }

  .tomorrow-day {
    font-size: 0.8em;
    font-weight: 500;
    color: var(--color-muted);
    font-style: normal;
    letter-spacing: 0;
  }

  .tomorrow-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: #FFFFFF;
    padding: 0.25rem 0.5rem;
  }

  .tomorrow-list > div + div {
    border-top: 1px solid #ECEEF1;
  }

  .tomorrow-empty-msg {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  /* ─── Botón "Ver programa completo →" ── */
  .upcoming-cta-wrap {
    padding-top: 0.5rem;
  }

  .btn-see-all-schedule {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink);
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease, transform 0.12s ease;
    letter-spacing: -0.005em;
  }

  .btn-see-all-schedule:hover {
    border-color: #D1D5DB;
    background-color: #F9FAFB;
    color: var(--color-accent);
  }

  .btn-see-all-schedule:active {
    transform: scale(0.985);
  }

  .cta-arrow {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .btn-see-all-schedule:hover .cta-arrow {
    transform: translateX(3px);
  }

  @media (min-width: 480px) {
    .btn-see-all-schedule {
      width: auto;
      min-width: 240px;
      padding-inline: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-see-all-schedule,
    .cta-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
