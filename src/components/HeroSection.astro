---
// HeroSection.astro — Hero moderno con jerarquía clara y copy directo
interface Props {
  feriaName: string;
  town: string;
  department: string;
  year: number;
  startDate: string;
  endDate: string;
  currentDayNumber: number;
  totalDays: number;
}

const {
  feriaName,
  town,
  department,
  year,
  startDate,
  endDate,
  currentDayNumber,
  totalDays,
} = Astro.props;

// ── Estado dinámico según la fecha actual ────────────────────────────────────
// "before"  → Antes de la feria   → Badge "PRÓXIMAMENTE"
// "active"  → Durante la feria    → Badge "EN CURSO"
// "after"   → Feria finalizada    → Badge "FERIA FINALIZADA"
const todayISO = new Date().toISOString().split("T")[0];
const startD = new Date(startDate + "T00:00:00");
const endD = new Date(endDate + "T23:59:59");
const todayD = new Date(todayISO + "T12:00:00");

type HeroState = "before" | "active" | "after";
const heroState: HeroState =
  todayD < startD ? "before" : todayD > endD ? "after" : "active";

// ── Rango de fechas: "5–11 de octubre" (sin duplicar año) ────────────────────
const fmtDay = (iso: string) =>
  new Date(iso + "T12:00:00").toLocaleDateString("es-HN", { day: "numeric" });
const fmtMonthLong = (iso: string) =>
  new Date(iso + "T12:00:00").toLocaleDateString("es-HN", { month: "long" });

const startDay = fmtDay(startDate);
const endDay = fmtDay(endDate);
const monthLabel = fmtMonthLong(startDate); // "octubre"

const dateRange = `${startDay}–${endDay} de ${monthLabel}`;
const defaultMeta = `${dateRange} · ${town}, ${department}`;

const todayFormatted = todayD.toLocaleDateString("es-HN", {
  day: "numeric",
  month: "long",
});
const activeMeta = `Hoy · ${todayFormatted} · ${town}, ${department}`;

const heroMetaText = heroState === "active" ? activeMeta : defaultMeta;
---

<section class="hero" aria-label={`Bienvenida a la ${feriaName}`}>
  <!-- Imagen de fondo -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/hero.avif"
      alt=""
      class="hero-img"
      loading="eager"
      fetchpriority="high"
      width="1400"
      height="788"
    />
    <div class="hero-overlay"></div>
  </div>

  <!-- Contenido con jerarquía visual estricta -->
  <div class="hero-content container">
    <!-- 1. Pequeño indicador superior de estado (sin fechas adentro) -->
    <div class="hero-badge-wrap">
      {
        heroState === "active" && (
          <span class="hero-status-badge hero-status-badge--active">
            <span class="badge-dot" aria-hidden="true" />
            EN CURSO
          </span>
        )
      }
      {
        heroState === "before" && (
          <span class="hero-status-badge">PRÓXIMAMENTE</span>
        )
      }
      {
        heroState === "after" && (
          <span class="hero-status-badge">FERIA FINALIZADA</span>
        )
      }
    </div>

    <!-- 2. Contexto + Mensaje Principal (H1) -->
    <div class="hero-title-block">
      <p class="hero-pre">FERIA PATRONAL</p>
      <h1 class="hero-title">
        {
          heroState === "after"
            ? "Gracias por celebrar con nosotros"
            : `${town} está de feria`
        }
      </h1>
    </div>

    <!-- 3. Información clara: fechas y lugar (una sola vez) -->
    <p class="hero-meta">
      {heroMetaText}
    </p>

    <!-- 4. Acción principal única -->
    <div class="hero-cta">
      <a
        href="#hoy"
        class="btn-primary hero-btn"
        aria-label="Ver el programa de actividades de hoy"
      >
        <span>Ver programa de hoy</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 16 16"
          fill="currentColor"
          class="hero-btn-icon"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M8 2a.75.75 0 0 1 .75.75v8.69l3.22-3.22a.75.75 0 1 1 1.06 1.06l-4.5 4.5a.75.75 0 0 1-1.06 0l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.22 3.22V2.75A.75.75 0 0 1 8 2Z"
            clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* ─── Shell ──────────────────────────────────────── */
  .hero {
    position: relative;
    /*
      Mobile-first: 75–85dvh para impacto sin saturar la pantalla.
      dvh respeta la barra de navegación del navegador en mobile.
    */
    min-height: clamp(380px, 78dvh, 520px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* ─── Background ─────────────────────────────────── */
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(15 10 5 / 0.12) 0%,
      rgb(15 10 5 / 0.38) 32%,
      rgb(15 10 5 / 0.85) 68%,
      rgb(15 10 5 / 0.97) 100%
    );
  }

  /* ─── Content Container ──────────────────────────── */
  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: 1.5rem 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  /* ─── 1. Badge superior ──────────────────────────── */
  .hero-badge-wrap {
    display: flex;
    align-items: center;
  }

  .hero-status-badge {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 0.25em 0.65em;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    line-height: 1.2;
  }

  .hero-status-badge--active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #ffffff;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    flex-shrink: 0;
    animation: pulse-dot 2s ease infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  /* ─── 2. Título principal ────────────────────────── */
  .hero-title-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .hero-pre {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0;
    line-height: 1.2;
  }

  .hero-title {
    font-family: var(--font-body);
    font-size: clamp(2.35rem, 11vw, 4.25rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin: 0;
    max-width: 14ch;
  }

  /* ─── 3. Meta (Fechas + Lugar) ───────────────────── */
  .hero-meta {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 4vw, 1.0625rem);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    margin: 0.15rem 0 0.35rem;
    letter-spacing: -0.005em;
    line-height: 1.4;
  }

  /* ─── Hero Entrance Animation ─────────────────────── */
  .hero-badge-wrap,
  .hero-title-block,
  .hero-meta,
  .hero-cta {
    opacity: 0;
    transform: translateY(10px);
    animation: hero-fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-badge-wrap {
    animation-delay: 0.05s;
  }
  .hero-title-block {
    animation-delay: 0.12s;
  }
  .hero-meta {
    animation-delay: 0.18s;
  }
  .hero-cta {
    animation-delay: 0.24s;
  }

  @keyframes hero-fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── 4. CTA principal ───────────────────────────── */
  .hero-cta {
    margin-top: 0.25rem;
  }

  .hero-btn {
    width: 100%;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.15s ease;
    will-change: transform;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-btn:hover {
      transform: scale(1.01);
    }
    .hero-btn:hover .hero-btn-icon {
      transform: translateY(2px);
    }
  }

  .hero-btn:active {
    transform: scale(0.985);
    transition-duration: 0.08s;
  }

  .hero-btn-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  /* ─── Breakpoints ────────────────────────────────── */
  @media (min-width: 480px) {
    .hero-btn {
      width: auto;
      padding-inline: 1.75rem;
    }

    .hero-content {
      padding-bottom: 2.75rem;
    }
  }

  @media (min-width: 768px) {
    .hero {
      min-height: clamp(440px, 72vh, 600px);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: clamp(500px, 68vh, 680px);
    }

    .hero-title {
      font-size: clamp(3.25rem, 5.5vw, 4.75rem);
      max-width: 16ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge-wrap,
    .hero-title-block,
    .hero-meta,
    .hero-cta {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .hero-btn {
      transition: none;
      transform: none !important;
    }
  }
</style>
