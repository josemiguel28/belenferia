---
// FullScheduleModal.astro — Bottom Sheet (Mobile) / Modal Centrado (Desktop)
// Acordeón rápido y compacto de los 7 días de la feria.
// Fuente única de datos: feria.days
import type { FeriaDay } from "../data/feria";

interface Props {
  days: FeriaDay[];
  initialDayIndex: number;
}

const { days, initialDayIndex } = Astro.props;

// Helper: formato de nombre del día "Lun 5"
const formatDayName = (day: FeriaDay) => {
  const d = new Date(day.date + "T12:00:00");
  const wd = d.toLocaleDateString("es-HN", { weekday: "short" });
  const wdCap = wd.charAt(0).toUpperCase() + wd.slice(1).replace(".", "");
  return `${wdCap} ${day.dayNumber}`;
};

const formatDayFull = (day: FeriaDay) => {
  const d = new Date(day.date + "T12:00:00");
  const wd = d.toLocaleDateString("es-HN", { weekday: "long", day: "numeric", month: "long" });
  return wd.charAt(0).toUpperCase() + wd.slice(1);
};

// Rango de fechas: "5–11 de octubre"
const startDayNum = days[0]?.dayNumber ?? 5;
const endDayNum = days[days.length - 1]?.dayNumber ?? 11;
const monthName = days[0] ? new Date(days[0].date + "T12:00:00").toLocaleDateString("es-HN", { month: "long" }) : "octubre";
const dateRangeSubtitle = `${startDayNum}–${endDayNum} de ${monthName}`;
---

<!-- Backdrop y contenedor del modal -->
<div
  id="schedule-modal-backdrop"
  class="schedule-backdrop"
  aria-hidden="true"
  data-initial-today-index={initialDayIndex}
>
  <div
    id="schedule-modal"
    class="schedule-sheet"
    role="dialog"
    aria-modal="true"
    aria-labelledby="schedule-modal-title"
    tabindex="-1"
  >
    <!-- Barra superior para mobile (drag handle visual) -->
    <div class="sheet-handle-bar" aria-hidden="true">
      <div class="sheet-drag-pill"></div>
    </div>

    <!-- Encabezado del modal -->
    <header class="sheet-header">
      <div class="sheet-header-text">
        <h2 id="schedule-modal-title" class="sheet-title">PROGRAMA DE LA FERIA</h2>
        <p class="sheet-subtitle">{dateRangeSubtitle}</p>
      </div>
      <button
        type="button"
        id="schedule-modal-close"
        class="sheet-close-btn"
        aria-label="Cerrar programa de la feria"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="close-icon" aria-hidden="true">
          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
        </svg>
      </button>
    </header>

    <!-- Contenido scrollable: Acordeón de días -->
    <div class="sheet-body" id="sheet-body">
      <div class="schedule-accordion" role="region" aria-label="Días de la feria">
        {days.map((day, i) => {
          const isInitialToday = i === initialDayIndex;
          const dayTitle = formatDayName(day);
          const fullLabel = formatDayFull(day);
          return (
            <details
              class:list={["schedule-day", { "is-today": isInitialToday }]}
              id={`schedule-day-${i}`}
              data-day-index={i}
              data-day-date={day.date}
              open={isInitialToday}
            >
              <summary
                class="schedule-day-summary"
                aria-label={`${fullLabel}: ${day.activities.length} actividades`}
              >
                <div class="summary-left">
                  <span class="day-short-name">{dayTitle}</span>
                  <span class="day-today-tag" data-today-indicator style={isInitialToday ? "" : "display: none;"}>
                    HOY
                  </span>
                </div>
                <div class="summary-right">
                  <span class="day-count">{day.activities.length} {day.activities.length === 1 ? "actividad" : "actividades"}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="chevron-icon" aria-hidden="true">
                    <path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </div>
              </summary>

              <!-- Lista interactiva de actividades -->
              <div class="schedule-day-content" role="list">
                {day.activities.map((act) => (
                  <div role="listitem">
                    <button
                      type="button"
                      class="schedule-act-btn"
                      data-open-activity
                      data-title={act.title}
                      data-time={act.time}
                      data-date={fullLabel}
                      data-category={act.category}
                      data-description={act.description ?? ""}
                      data-maps-url={act.mapsUrl ?? ""}
                      aria-label={`Ver detalles de ${act.title}, a las ${act.time}`}
                    >
                      <span class="act-time">{act.time}</span>
                      <div class="act-info">
                        <p class="act-title">{act.title}</p>
                      </div>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="act-chevron" aria-hidden="true">
                        <path fill-rule="evenodd" d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                      </svg>
                    </button>
                  </div>
                ))}
              </div>
            </details>
          );
        })}
      </div>
    </div>
  </div>
</div>

<script>
  function initModal() {
    const backdrop = document.getElementById("schedule-modal-backdrop");
    const modal = document.getElementById("schedule-modal");
    const closeBtn = document.getElementById("schedule-modal-close");
    if (!backdrop || !modal) return;

    if (backdrop.dataset.modalBound === "true") return;
    backdrop.dataset.modalBound = "true";

    const dayItems = Array.from(
      document.querySelectorAll<HTMLDetailsElement>(".schedule-day"),
    );

    const initialIdx = parseInt(
      backdrop.dataset.initialTodayIndex || "0",
      10,
    );

    let todayISO = "";
    try {
      const formatter = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Tegucigalpa",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      });
      const parts = formatter.formatToParts(new Date());
      const y = parts.find((p) => p.type === "year")?.value;
      const m = parts.find((p) => p.type === "month")?.value;
      const d = parts.find((p) => p.type === "day")?.value;
      todayISO = `${y}-${m}-${d}`;
    } catch {
      todayISO = new Date().toISOString().split("T")[0];
    }

    let actualTodayIdx = -1;
    dayItems.forEach((el, idx) => {
      if (el.dataset.dayDate === todayISO) actualTodayIdx = idx;
    });

    const activeTodayIdx =
      actualTodayIdx !== -1 ? actualTodayIdx : initialIdx;

    dayItems.forEach((el, idx) => {
      const isToday = actualTodayIdx !== -1 && idx === actualTodayIdx;
      const tag = el.querySelector("[data-today-indicator]");
      if (tag)
        (tag as HTMLElement).style.display = isToday ? "inline-flex" : "none";
      el.classList.toggle("is-today", isToday);
      el.open = idx === activeTodayIdx;
    });

    // Acordeón suave y robusto con Web Animations API nativo
    dayItems.forEach((details) => {
      const summary = details.querySelector(".schedule-day-summary") as HTMLElement | null;
      const content = details.querySelector(".schedule-day-content") as HTMLElement | null;
      if (!summary || !content) return;

      let isAnimating = false;

      summary.addEventListener("click", (e) => {
        e.preventDefault();

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          details.open = !details.open;
          return;
        }

        if (isAnimating) return;

        if (details.open) {
          // CERRAR suavemente
          isAnimating = true;
          const startHeight = content.offsetHeight;
          content.style.overflow = "hidden";

          const anim = content.animate(
            [
              { height: `${startHeight}px`, opacity: 1 },
              { height: "0px", opacity: 0 }
            ],
            {
              duration: 200,
              easing: "cubic-bezier(0.16, 1, 0.3, 1)"
            }
          );

          anim.onfinish = () => {
            details.open = false;
            content.style.height = "";
            content.style.opacity = "";
            content.style.overflow = "";
            isAnimating = false;
          };

          anim.oncancel = () => {
            isAnimating = false;
          };
        } else {
          // ABRIR suavemente
          details.open = true;
          isAnimating = true;
          content.style.overflow = "hidden";
          const targetHeight = content.scrollHeight;

          const anim = content.animate(
            [
              { height: "0px", opacity: 0 },
              { height: `${targetHeight}px`, opacity: 1 }
            ],
            {
              duration: 220,
              easing: "cubic-bezier(0.16, 1, 0.3, 1)"
            }
          );

          anim.onfinish = () => {
            content.style.height = "";
            content.style.opacity = "";
            content.style.overflow = "";
            isAnimating = false;
          };

          anim.oncancel = () => {
            isAnimating = false;
          };
        }
      });
    });

    let previousActiveElement: HTMLElement | null = null;

    const openModal = (targetDayIndex?: number) => {
      previousActiveElement = document.activeElement as HTMLElement | null;
      backdrop.classList.add("is-open");
      modal.classList.add("is-visible");
      backdrop.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      modal.focus();

      // Si se solicita abrir un día específico (ej. mañana), abrir ese acordeón
      if (
        typeof targetDayIndex === "number" &&
        !isNaN(targetDayIndex) &&
        targetDayIndex >= 0 &&
        targetDayIndex < dayItems.length
      ) {
        dayItems.forEach((el, idx) => {
          el.open = idx === targetDayIndex;
        });
      } else {
        dayItems.forEach((el, idx) => {
          el.open = idx === activeTodayIdx;
        });
      }

      // Scroll del acordeón al día abierto
      setTimeout(() => {
        const targetEl =
          modal.querySelector(".schedule-day[open]") ||
          modal.querySelector(".schedule-day.is-today");
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      }, 150);
    };

    const closeModal = () => {
      modal.classList.remove("is-visible");
      backdrop.classList.remove("is-open");
      backdrop.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";

      if (previousActiveElement) {
        previousActiveElement.focus();
      }
    };

    closeBtn?.addEventListener("click", closeModal);

    backdrop.addEventListener("click", (e) => {
      if (e.target === backdrop) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && backdrop.classList.contains("is-open")) {
        // Solo cerramos schedule si el detail modal no está abierto encima
        const detailBackdrop = document.getElementById("activity-detail-backdrop");
        if (!detailBackdrop || !detailBackdrop.classList.contains("is-open")) {
          closeModal();
        }
      }
    });

    // Enlaces o botones con data-open-schedule abren el modal
    document.addEventListener("click", (e) => {
      const trigger = (e.target as HTMLElement).closest("[data-open-schedule]");
      if (trigger) {
        e.preventDefault();
        const dayAttr = (trigger as HTMLElement).dataset.scheduleDay;
        const targetIdx =
          dayAttr !== undefined && dayAttr !== ""
            ? parseInt(dayAttr, 10)
            : undefined;
        openModal(targetIdx);
      }
    });
  }

  initModal();
  document.addEventListener("astro:page-load", initModal);
</script>

<style>
  /* ─── Backdrop ─────────────────────────────────────── */
  .schedule-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .schedule-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* ─── Bottom Sheet (Mobile First) ─────────────────── */
  .schedule-sheet {
    background-color: var(--color-bg);
    width: 100%;
    height: 90vh;
    max-height: 90vh;
    border-radius: 16px 16px 0 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.15);
    transform: translateY(100%);
    transition: transform 0.26s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }

  .schedule-sheet.is-visible {
    transform: translateY(0);
  }

  /* ─── Drag Handle (Mobile) ────────────────────────── */
  .sheet-handle-bar {
    display: flex;
    justify-content: center;
    padding: 0.625rem 0 0.25rem;
    flex-shrink: 0;
  }

  .sheet-drag-pill {
    width: 36px;
    height: 4px;
    border-radius: 999px;
    background-color: #D1D5DB;
  }

  /* ─── Header del Modal ────────────────────────────── */
  .sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem 1rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
    background: #FFFFFF;
  }

  .sheet-title {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .sheet-subtitle {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
    margin: 0.15rem 0 0;
  }

  .sheet-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #F3F4F6;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .sheet-close-btn:hover {
    background: #E5E7EB;
    color: var(--color-accent);
  }

  .close-icon {
    width: 20px;
    height: 20px;
  }

  /* ─── Cuerpo con scroll ────────────────────────────── */
  .sheet-body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.25rem 0 2rem;
  }

  /* ─── Acordeón ─────────────────────────────────────── */
  .schedule-accordion {
    display: flex;
    flex-direction: column;
  }

  .schedule-day {
    border-bottom: 1px solid var(--color-border);
  }

  .schedule-day-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 1.25rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    min-height: 52px;
    transition: background-color 0.12s ease;

    &::-webkit-details-marker { display: none; }
    &::marker { display: none; }
  }

  .schedule-day-summary:hover {
    background-color: #F9FAFB;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .day-short-name {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  /* Badge SUTIL "HOY" */
  .day-today-tag {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(240, 90, 22, 0.12);
    padding: 0.15em 0.5em;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
  }

  .summary-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .day-count {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .chevron-icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-muted);
    transition: transform 0.2s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .schedule-day[open] .chevron-icon {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  /* ─── Lista de actividades interactivas ───────────── */
  .schedule-day-content {
    background: #F8F9FA;
    padding: 0.35rem 0.75rem 0.6rem;
    border-top: 1px solid var(--color-border);
  }

  .schedule-act-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.65rem 0.5rem;
    background: transparent;
    border: none;
    border-radius: 6px;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.15s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    font-family: inherit;
  }

  .schedule-act-btn:hover {
    background-color: #FFFFFF;
  }

  .schedule-act-btn:active {
    background-color: #E5E7EB;
  }

  .schedule-day-content > div + div .schedule-act-btn {
    border-top: 1px solid #ECEEF1;
  }

  .act-time {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
    white-space: nowrap;
    width: 4.25rem;
    text-align: left;
    flex-shrink: 0;
  }

  .act-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .act-title {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
    margin: 0;
    word-break: break-word;
  }

  .act-chevron {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    color: #9CA3AF;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .schedule-act-btn:hover .act-chevron {
    transform: translateX(2px);
    color: var(--color-accent);
  }

  /* ─── Desktop (>= 640px): Modal Centrado ───────────── */
  @media (min-width: 640px) {
    .schedule-backdrop {
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .sheet-handle-bar {
      display: none;
    }

    .schedule-sheet {
      width: 100%;
      max-width: 580px;
      height: auto;
      max-height: 82vh;
      border-radius: 16px;
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.2);
      transform: scale(0.95);
      transition: transform 0.2s var(--ease-out);
    }

    .schedule-sheet.is-visible {
      transform: scale(1);
    }

    .sheet-header {
      padding: 1.125rem 1.5rem;
    }

    .sheet-title {
      font-size: 1.15rem;
    }

    .sheet-body {
      padding: 0.25rem 0 1.5rem;
    }

    .schedule-day-summary {
      padding: 1rem 1.5rem;
    }

    .schedule-day-content {
      padding: 0.65rem 1.25rem 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .schedule-backdrop,
    .schedule-sheet,
    .chevron-icon,
    .act-chevron {
      transition: none !important;
      transform: none !important;
    }
    .schedule-sheet.is-visible {
      transform: none !important;
    }
  }
</style>
