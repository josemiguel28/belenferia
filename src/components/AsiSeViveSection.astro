---
// AsiSeViveSection.astro — "ASÍ SE VIVE BELÉN"
// Exploración de composición y distribución de fotografías Mobile-First (~390px)
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import foto01 from "../assets/images/galeria/foto-01.avif";
import foto02 from "../assets/images/galeria/foto-02.avif";
import foto03 from "../assets/images/galeria/foto-03.avif";
import foto04 from "../assets/images/galeria/foto-04.avif";
import foto05 from "../assets/images/galeria/foto-05.avif";
import foto06 from "../assets/images/galeria/foto-06.avif";
import foto07 from "../assets/images/galeria/foto-07.avif";

export interface GalleryItem {
  id: string;
  image: ImageMetadata;
  alt: string;
  aspectRatio: string;
  contextHint: string;
  colSpan: 1 | 2;
  sizes: string;
  widths: number[];
}

const items: GalleryItem[] = [
  // ── 1. Foto Protagonista (100% ancho · 16:9) ──────────────────────────────
  {
    id: "photo-01",
    image: foto01,
    alt: "Vista panorámica del pueblo de Belén",
    aspectRatio: "16 / 9",
    contextHint: "Vista panorámica del pueblo",
    colSpan: 2,
    sizes: "(min-width: 1024px) 800px, 100vw",
    widths: [480, 800, 1200],
  },

  // ── 2 y 3. Dúo Vertical (2 columnas · 4:5) ─────────────────────────────────
  {
    id: "photo-02",
    image: foto02,
    alt: "Calles empedradas y arquitectura colonial de Belén",
    aspectRatio: "4 / 5",
    contextHint: "Calles y arquitectura",
    colSpan: 1,
    sizes: "(min-width: 1024px) 400px, 50vw",
    widths: [320, 640],
  },
  {
    id: "photo-03",
    image: foto03,
    alt: "Detalles y tradiciones de la comunidad",
    aspectRatio: "4 / 5",
    contextHint: "Tradición y detalles",
    colSpan: 1,
    sizes: "(min-width: 1024px) 400px, 50vw",
    widths: [320, 640],
  },

  // ── 4. Foto Central (100% ancho · 16:9) ────────────────────────────────────
  {
    id: "photo-04",
    image: foto04,
    alt: "Ambiente y momentos de la feria",
    aspectRatio: "16 / 9",
    contextHint: "Ambiente de la feria",
    colSpan: 2,
    sizes: "(min-width: 1024px) 800px, 100vw",
    widths: [480, 800, 1200],
  },

  // ── 5 y 6. Dúo Cuadrado (2 columnas · 1:1) ─────────────────────────────────
  {
    id: "photo-05",
    image: foto05,
    alt: "Gente y familias de Belén",
    aspectRatio: "1 / 1",
    contextHint: "Gente de Belén",
    colSpan: 1,
    sizes: "(min-width: 1024px) 400px, 50vw",
    widths: [320, 640],
  },
  {
    id: "photo-06",
    image: foto06,
    alt: "Celebración y alegría durante los días de feria",
    aspectRatio: "1 / 1",
    contextHint: "Momentos de la feria",
    colSpan: 1,
    sizes: "(min-width: 1024px) 400px, 50vw",
    widths: [320, 640],
  },

  // ── 7. Cierre Panorámico (100% ancho · 16:9) ──────────────────────────────
  {
    id: "photo-07",
    image: foto07,
    alt: "Atardecer en la plaza municipal de Belén",
    aspectRatio: "16 / 9",
    contextHint: "Atardecer en la plaza",
    colSpan: 2,
    sizes: "(min-width: 1024px) 800px, 100vw",
    widths: [480, 800, 1200],
  },
];
---

<section id="asi-se-vive" class="vive-section" aria-label="Así se vive Belén">
  <div class="container">
    <!-- ── Encabezado ─────────────────────────────────────────────── -->
    <header class="vive-header">
      <p class="vive-eyebrow">¿Cómo es Belén?</p>
      <h2 class="vive-title">Así se vive Belén</h2>
      <p class="vive-subtitle">
        Una mirada al pueblo, sus paisajes y los momentos de la feria.
      </p>
    </header>

    <!-- ── Grid de Composición (Mobile-First) ─────────────────────── -->
    <div
      class="vive-grid"
      role="region"
      aria-label="Composición fotográfica de Belén"
    >
      {
        items.map((item) => (
          <div
            class:list={[
              "vive-item",
              item.colSpan === 2 ? "vive-item--full" : "vive-item--half",
            ]}
            style={`--aspect-ratio: ${item.aspectRatio};`}
            data-id={item.id}
          >
            <figure class="photo-card">
              <Image
                src={item.image}
                alt={item.alt || item.contextHint}
                class="photo-img"
                widths={item.widths}
                sizes={item.sizes}
                format="avif"
                quality={75}
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const setupGalleryReveal = () => {
    const items = document.querySelectorAll(".vive-item");
    if (!items.length) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      items.forEach((item) => item.classList.add("is-revealed"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        rootMargin: "0px 0px -30px 0px",
        threshold: 0.12,
      },
    );

    items.forEach((item, index) => {
      if (item.classList.contains("vive-item--half") && index % 2 === 1) {
        (item as HTMLElement).style.transitionDelay = "0.05s";
      }
      observer.observe(item);
    });
  };

  setupGalleryReveal();
  document.addEventListener("astro:page-load", setupGalleryReveal);
</script>

<style>
  /* ─── Sección ────────────────────────────────────────────── */
  .vive-section {
    background-color: var(--color-bg);
    padding-block: 3.5rem;
    border-top: 1px solid var(--color-border);
  }

  /* ─── Encabezado ─────────────────────────────────────────── */
  .vive-header {
    margin-bottom: 2rem;
  }

  .vive-eyebrow {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 0.5rem;
  }

  .vive-title {
    font-family: var(--font-body);
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin: 0 0 0.5rem;
  }

  .vive-subtitle {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
    max-width: 44ch;
    line-height: 1.5;
  }

  /* ─── Grid de Composición (Mobile-First: 2 columnas con span flexible) ── */
  .vive-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem; /* 12px de separación */
  }

  .vive-item {
    position: relative;
    width: 100%;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.38s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.38s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .vive-item.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .vive-item--full {
    grid-column: span 2;
  }

  .vive-item--half {
    grid-column: span 1;
  }

  /* ═══════════════════════════════════════════════════════════
     FOTOGRAFÍAS REALES
     ═══════════════════════════════════════════════════════════ */
  .photo-card {
    position: relative;
    width: 100%;
    aspect-ratio: var(--aspect-ratio, 16 / 9);
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    background-color: #f3f4f6;
    border: 1px solid var(--color-border);
  }

  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .photo-card:hover .photo-img {
    transform: scale(1.02);
  }

  /* ═══════════════════════════════════════════════════════════
     PLACEHOLDERS NEUTROS (sin etiquetas de texto)
     ═══════════════════════════════════════════════════════════ */
  .placeholder-box {
    position: relative;
    width: 100%;
    aspect-ratio: var(--aspect-ratio, 16 / 9);
    background-color: #f8f9fa;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .placeholder-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(0, 0, 0, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  .placeholder-center {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photo-indicator {
    color: #9ca3af;
    opacity: 0.6;
  }

  .camera-icon {
    width: 32px;
    height: 32px;
  }

  /* ─── Tablet y Desktop ───────────────────────────────────── */
  @media (min-width: 580px) {
    .vive-grid {
      gap: 1rem;
    }
    .placeholder-box,
    .photo-card {
      border-radius: 12px;
    }
    .camera-icon {
      width: 36px;
      height: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vive-item {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .photo-img {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
