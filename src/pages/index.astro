---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import HeroSection from "../components/HeroSection.astro";
import TodaySection from "../components/TodaySection.astro";
import PuebloSection from "../components/PuebloSection.astro";
import AsiSeViveSection from "../components/AsiSeViveSection.astro";
import InfoSection from "../components/InfoSection.astro";
import SponsorsSection from "../components/SponsorsSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FullScheduleModal from "../components/FullScheduleModal.astro";
import ActivityDetailModal from "../components/ActivityDetailModal.astro";
import { feria } from "../data/feria";

// ─── Determinar el día actual ─────────────────────────────────────────────────
const todayISO = new Date().toISOString().split("T")[0];
let todayIndex = feria.days.findIndex((d) => d.date === todayISO);

// Fallback para demo: si estamos fuera del rango de la feria usamos el día 1
// (Martes 06, índice 1) para mostrar un día con variedad de actividades.
if (todayIndex === -1) todayIndex = 1;

const todayDay = feria.days[todayIndex];
const dayNumber = todayIndex + 1;

// ─── Meta dinámica ────────────────────────────────────────────────────────────
const fullDate = new Date(todayDay.date + "T12:00:00");
const dayLabel = fullDate.toLocaleDateString("es-HN", {
  weekday: "long",
  day: "numeric",
  month: "long",
});
const dayLabelCap = dayLabel.charAt(0).toUpperCase() + dayLabel.slice(1);

const pageTitle = `${feria.name} ${feria.year} — ${dayLabelCap}`;
const pageDesc = `Programa del ${dayLabelCap} en la ${feria.name} ${feria.year}. Actividades, restaurantes y guía de ${feria.town}, ${feria.department}.`;
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <!-- ① Navbar -->
  <NavBar shortName={feria.shortName} />

  <main id="main-content">
    <!-- ② Hero -->
    <HeroSection
      feriaName={feria.name}
      town={feria.town}
      department={feria.department}
      year={feria.year}
      startDate={feria.startDate}
      endDate={feria.endDate}
      currentDayNumber={dayNumber}
      totalDays={feria.totalDays}
    />

    <!-- ③ ¿Qué hay hoy? — recibe TODOS los días para la navegación client-side -->
    <TodaySection
      days={feria.days}
      initialDayIndex={todayIndex}
      totalDays={feria.totalDays}
    />

    <!-- ④ Descubre el pueblo -->
    <PuebloSection />

    <!-- ⑤ Así se vive Belén -->
    <AsiSeViveSection />

    <!-- ⑦ Patrocinadores y colaboradores -->
    <SponsorsSection />

    <!-- ⑥ Información práctica -->
    <InfoSection />
  </main>

  <!-- ⑦ Footer -->
  <SiteFooter
    feriaName={feria.name}
    town={feria.town}
    department={feria.department}
    year={feria.year}
  />

  <!-- ⑧ Modal / Bottom Sheet del Programa Completo -->
  <FullScheduleModal days={feria.days} initialDayIndex={todayIndex} />

  <!-- ⑨ Modal / Bottom Sheet del Detalle de Actividad -->
  <ActivityDetailModal />
</BaseLayout>

<style>
  .skip-link {
    position: absolute;
    top: -999px;
    left: 1rem;
    z-index: 200;
    background: var(--color-accent);
    color: #fff;
    padding: 0.625rem 1.25rem;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: 0 0 6px 6px;
  }
  .skip-link:focus {
    top: 0;
  }
</style>
