---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import HeroSection from "../components/HeroSection.astro";
import TodaySection from "../components/TodaySection.astro";
import PuebloSection from "../components/PuebloSection.astro";
import AsiSeViveSection from "../components/AsiSeViveSection.astro";
import InfoSection from "../components/InfoSection.astro";
import SponsorsSection from "../components/SponsorsSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FullScheduleModal from "../components/FullScheduleModal.astro";
import ActivityDetailModal from "../components/ActivityDetailModal.astro";
import { feria } from "../data/feria";
import { getFairState } from "../utils/fairState";

// ─── Estado temporal de la feria (Zona Horaria Oficial: America/Tegucigalpa) ───
const fairState = getFairState();

// ─── Meta dinámica ────────────────────────────────────────────────────────────
const pageTitle = `${feria.name} ${feria.year} — ${fairState.dateFormatted}`;
const pageDesc = `Guía y programa oficial de la ${feria.name} ${feria.year} en ${feria.town}, ${feria.department}. Fechas: ${fairState.dateRangeLabel}.`;
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <!-- ① Navbar -->
  <NavBar shortName={feria.shortName} />

  <main id="main-content">
    <!-- ② Hero -->
    <HeroSection
      feriaName={feria.name}
      town={feria.town}
      department={feria.department}
      year={feria.year}
      fairState={fairState}
    />

    <!-- ③ Sección principal según el estado temporal (BEFORE / DURING / AFTER) -->
    <TodaySection
      fairState={fairState}
      days={feria.days}
    />

    <!-- ④ Descubre el pueblo -->
    <PuebloSection />

    <!-- ⑤ Así se vive Belén -->
    <AsiSeViveSection />

    <!-- ⑦ Patrocinadores y colaboradores -->
    <SponsorsSection />

    <!-- ⑥ Información práctica -->
    <InfoSection />
  </main>

  <!-- ⑦ Footer -->
  <SiteFooter
    feriaName={feria.name}
    town={feria.town}
    department={feria.department}
    year={feria.year}
  />

  <!-- ⑧ Modal / Bottom Sheet del Programa Completo -->
  <FullScheduleModal
    days={feria.days}
    initialDayIndex={fairState.currentDayIndex}
  />

  <!-- ⑨ Modal / Bottom Sheet del Detalle de Actividad -->
  <ActivityDetailModal />
</BaseLayout>

<style>
  .skip-link {
    position: absolute;
    top: -999px;
    left: 1rem;
    z-index: 200;
    background: var(--color-accent);
    color: #fff;
    padding: 0.625rem 1.25rem;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: 0 0 6px 6px;
  }
  .skip-link:focus {
    top: 0;
  }
</style>
